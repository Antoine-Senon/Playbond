P1P1WFS0LB":{"type":2,"data":{"detailLevel":1,"productId":"9NP1P1WFS0LB","title":"Halo Infinite","tileImageUrl":"\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.30769.13727851868390641.270e98c5-0c6a-4ce0-81ab-e78c700bf4b5.092f9454-fee6-43b1-94e3-802dd0067d8b","posterImageUrl":"\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.21536.13727851868390641.c9cc5f66-aff8-406c-af6b-440838730be0.68796bde-cbf5-4eaa-a299-011417041da6","screenshots":[{"URL":"\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.25655.13727851868390641.dedb8633-ca6a-48c4-b33f-dc6f6356fa51.694b1948-51bf-45dd-af07-1219b60ff841","Caption":"A spherical, floating Forerunner Monitor robot hovers over a construction site in a mountainous valley."},{"URL":"\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.61194.13727851868390641.dedb8633-ca6a-48c4-b33f-dc6f6356fa51.3aaa7c00-76f1-4f6b-82b6-68d1fcae4547","Caption":"Two Spartans race forward with weapons drawn, as a fiery explosion pursues down a narrow hall."},{"URL":"\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.45703.13727851868390641.dedb8633-ca6a-48c4-b33f-dc6f6356fa51.0d1af4c8-6c91-49e3-abb1-303f6c83267d","Caption":"Survivor Spartans mount a hopeless defense as Infected Spartans armored in skeletal, holographic projections pursue them with Energy Swords."},{"URL":"\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.5568.13727851868390641.dedb8633-ca6a-48c4-b33f-dc6f6356fa51.70eadab4-50f0-4957-abb1-b029f3583307","Caption":"A Juggernaut Spartan wields the Mutilator, a formidable shotgun with a hammer-like muzzle, in the Mutilator Madness multiplayer mode."},{"URL":"\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.41036.13727851868390641.dedb8633-ca6a-48c4-b33f-dc6f6356fa51.bf5a0bee-6c62-4dce-b191-24cdfd27628a","Caption":"A team of Spartans defends a fortified position behind a wall of sandbags from incoming waves of Banished alien forces."},{"URL":"\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.41729.13727851868390641.dedb8633-ca6a-48c4-b33f-dc6f6356fa51.ecef1b94-a0a6-4a26-b494-8b90a4ce4f45","Caption":"A team of Spartans engage in close aerial combat with a Banshee from their Falcon helicopter. The Banshee is covered in blue lightning, malfunctioning from an overcharged Plasma Pistol shot."},{"URL":"\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.33504.13727851868390641.dedb8633-ca6a-48c4-b33f-dc6f6356fa51.b6fd70d9-b26c-4878-a2d1-4e8216bdfb13","Caption":"Four players engage unseen enemies as multiple instances of the Master Chief. The armored heroes wield a variety of different weaponry."},{"URL":"\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.45886.13727851868390641.dedb8633-ca6a-48c4-b33f-dc6f6356fa51.9a126cad-44e4-4c55-80ea-f83fb2b67a3c","Caption":"A first-person view of Halo Infinite Campaign gameplay. The player fires a Battle Rifle at an incoming Brute in a metallic Forerunner facility, causing the foe’s armor to glow."},{"URL":"\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.21687.13727851868390641.dedb8633-ca6a-48c4-b33f-dc6f6356fa51.0c1430bb-e1ba-4668-b957-bd6ed58738ed","Caption":"The Master Chief confers with a holographic projection of The Weapon, a blue woman in a flight suit, in his open palm."}],"trailers":[{"ClosedCaptionsURL":null,"FormatURL":{"Smooth":null,"Dash":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F65b4a565-7138-4bc5-88e1-7b52ec3c4cc7-AVS.mpd","Hls":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F65b4a565-7138-4bc5-88e1-7b52ec3c4cc7-AVS.m3u8?packagedStreaming=true"},"PreviewImageURL":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.11703.13727851868390641.ccc2d91d-118b-47bc-b87a-a5cc449f8e8e.da60b42d-146e-424c-966c-6eb3be0fdf4d","Caption":"Halo Infinite - Campagne"},{"ClosedCaptionsURL":null,"FormatURL":{"Smooth":null,"Dash":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F7e8a543e-36d5-47b7-a011-885584178fb1-AVS.mpd","Hls":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F7e8a543e-36d5-47b7-a011-885584178fb1-AVS.m3u8?packagedStreaming=true"},"PreviewImageURL":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.40185.13727851868390641.6cf89dd1-3dd7-42fe-b7ac-ec2b3d09ccda.701b0a0b-299a-454a-802b-43dc4fe39664","Caption":"Halo Infinite Multiplayer"}],"genre":["Jeux de tir"],"publisherName":"Xbox Game Studios","heroImageUrl":"\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.50670.13727851868390641.c9cc5f66-aff8-406c-af6b-440838730be0.d205e025-5444-4eb1-ae46-571ae6895928","titledHeroImageUrl":"\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.24990.13727851868390641.c9cc5f66-aff8-406c-af6b-440838730be0.e136fdbb-a54f-4906-9712-e6313077f1f7","ratingAge":16,"ratingDescription":"16 ans et plus","ratingDescriptors":["Violence"],"ratingDisclaimers":[],"ratingValue":"PEGI 16","ratingValueLogoUrl":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fglobal.45689.image.95264dc7-2e11-4b4e-9f75-3a0691628d80.16710cb0-d93d-4311-83d3-bdcaa6f159de","ratingSystemLongName":"PEGI 16","ratingInteractiveElements":["Achats intra-jeu"],"ratingSystemUrl":"https:\u002F\u002Fpegi.info","ratingSystem":"PEGI","requiresXboxLiveGold":false,"description":"Multijoueur gratuit :  \n\nDécouvrez la version réinventée et gratuite du célèbre mode multijoueur de Halo ! Accompagné de plus de 70 cartes en matchmaking, de milliards de configurations de personnalisation et d'innombrables créations de Forge de la communauté à découvrir, Halo Infinite possède le mode multijoueur le plus vaste de la franchise à ce jour.\n\nPlongez dans une variété sans précédent d'expériences de jeu, allant des modes classés intenses au rythme effréné, au chaos fantaisiste des parties personnalisées, en passant par la coordination du mode coopératif de survie à vagues Baptême du feu : Roi de la colline. Avec quelque chose pour répondre aux préférences et au style de jeu de chaque joueur, il est temps d'enfiler votre combinaison et de créer votre équipe !\n\n \n\nBêta Forge : \n\nL'outil de création de contenu légendaire de Halo est plus puissant que jamais, offrant des fonctionnalités avancées telles qu'un nouveau moteur de script visuel, un éditeur de mode, une mise à l'échelle d'objets, d'éclairage et d'audio, ainsi que des améliorations notables de la fidélité et des limites de budget des objets.\n\nLa Forge comprend également le puissant kit d'outils IA, permettant aux joueurs d'ajouter une IA de campagne à leurs créations. Que ce soit pour recréer des expériences emblématiques des précédents opus de Halo ou pour concevoir quelque chose d'unique, les possibilités pour des cartes et des modes de jeu personnalisés passionnants sont infinies.\n\n \n\nJeu intergénération et multiplateforme :\n\nHalo Infinite propose une expérience exceptionnelle tant sur Xbox One que sur les consoles plus récentes ainsi que sur PC, avec des graphismes 4K époustouflants et un jeu multiplateforme de classe mondiale. Sur Xbox Series X et les PC pris en charge, bénéficiez de fonctionnalités améliorées telles que des fréquences d'image pouvant atteindre 120 IPS et des temps de chargement considérablement réduits, offrant ainsi un gameplay fluide qui marque le début de la prochaine génération de jeux.*\n\n*Profitez de jusqu'à 120 IPS et de la résolution 4K Ultra HD sur les consoles Xbox Series X et les PC compatibles, uniquement pour les cartes et modes pris en charge ; un téléviseur ou un moniteur compatible est requis.  \n","shortDescription":"Issu de l'une des sagas les plus emblématiques du jeu vidéo, Halo est plus grand que jamais avec une expérience multijoueur dynamique et gratuite.  \n","developerName":"343 Industries","privacyPolicyUrl":"https:\u002F\u002Fprivacy.microsoft.com\u002Fen-US\u002Fprivacystatement","privacyPolicyLabel":"Politique de confidentialité Halo Infinite","releaseDate":"2021-12-08T18:00:00Z","codeOfConductUrl":"http:\u002F\u002Fwww.xbox.com\u002Ffr-fr\u002Flegal\u002Fcodeofconduct","codeOfConductLabel":"Code de conduite Xbox Live","termsOfTransactionUrl":"https:\u002F\u002Fwww.microsoft.com\u002Ffr-fr\u002Fstore\u002Fb\u002Fterms-of-sale","termsOfTransactionLabel":"Conditions de la transaction","languageSupport":{},"accessibilityFeatures":{"Url":"https:\u002F\u002Fsupport.halowaypoint.com\u002Fhc\u002Farticles\u002F4408122295444","GamePlay":{"OnDemandTutorials":{"Tag":"Didacticiels à la demande"},"Pausable":{"Tag":"Pausable"}},"Audio":{"CustomVolumeControls":{"Tag":"Contrôles de volume multiples"},"SpatialAudio":{"Tag":"Son surround"}},"Visual":{"ColorOptions":{"Tag":"Options de couleur"}},"Input":{"AdjustableInputSensitivity":{"Tag":"Sensibilité d’entrée réglable"},"NoQuickTimeEvents":{"Tag":"Jouable sans appuis rapides sur les boutons"},"TtsSttCommunications":{"Tag":"Conversation de parole en texte & conversion de texte par synthèse vocale"},"PlayableWithoutMotionControls":{"Tag":"Jouable sans contrôles de mouvement"},"PlayableWithoutTouchControls":{"Tag":"Jouable sans contrôles tactiles"}}},"attributes":[{"Name":"XblOnlineMultiPlayer","LocalizedName":"Jeu multijoueur en ligne  (2-24)"},{"Name":"BroadcastSupport","LocalizedName":""},{"Name":"XblCrossPlatformMultiPlayer","LocalizedName":"Multijoueur multiplateforme Xbox"},{"Name":"Capability4k","LocalizedName":"4K Ultra HD"},{"Name":"CapabilityHDR","LocalizedName":"HDR10"},{"Name":"SinglePlayer","LocalizedName":"Joueur unique"},{"Name":"60fps","LocalizedName":"60 i\u002Fs et plus"},{"Name":"120fps","LocalizedName":"120 i\u002Fs"},{"Name":"DolbyAtmos","LocalizedName":"Dolby Atmos"},{"Name":"ConsoleCrossGen","LocalizedName":"Diffusion intelligente"},{"Name":"ConsoleKeyboardMouse","LocalizedName":"Clavier et souris de console"},{"Name":"PcGamePad","LocalizedName":"Manette de jeu PC"},{"Name":"XPA","LocalizedName":"Xbox Play Anywhere"},{"Name":"XboxLive","LocalizedName":"Xbox Live"}],"anonymousPrice":{"msrp":{"formattedValue":"69,99 €","value":69.99,"currencyCode":"EUR"},"salePrice":null},"inAppPurchaseDisclaimer":"Contient des achats dans l’application.","xboxTitleId":null,"childXboxTitleIds":["2043073184"],"compareEditions":[{"productId":"9NP1P1WFS0LB","productTitle":"Halo Infinite","includesSections":[{"title":"Jeux inclus","includes":["Halo Infinite"]},{"title":"Modules complémentaires inclus","includes":["Halo Infinite (campagne)"]}]}],"productDates":{"CFQ7TTC0K6L8":{"EntryDateUTC":"2021-12-08T18:00:00Z"},"CFQ7TTC0KGQ8":{"EntryDateUTC":"2021-12-08T18:00:00Z"},"CFQ7TTC0P85B":{"EntryDateUTC":"2024-08-12T14:00:00Z"}},"offerings":{"xgpu":{"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON"],"isAdditionalProduct":true,"supportedInputTypes":["controller","mkb"]},"xgpubeta":{"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON"],"isAdditionalProduct":true,"supportedInputTypes":["controller","mkb"]},"xgpuweb":{"programs":["CALLISTO","DIA","EUROPA","FERDINAND","GPULTIMATE","TRITON"],"isAdditionalProduct":true,"supportedInputTypes":["controller","mkb"]},"xgpupcapp":{"programs":["CALLISTO","DIA","EUROPA","FERDINAND","GPULTIMATE","TRITON"],"isAdditionalProduct":true,"supportedInputTypes":["controller","mkb"]},"xgpuconsole":{"programs":["CALLISTO","DIA","EUROPA","FERDINAND","GPULTIMATE","TRITON"],"isAdditionalProduct":true,"supportedInputTypes":["controller","mkb"]},"takehomeconsole":{"programs":["CALLISTO","DIA","EUROPA","FERDINAND","GPULTIMATE","TRITON"],"isAdditionalProduct":true,"supportedInputTypes":["controller","mkb"]},"takehome":{"programs":["CALLISTO","DIA","EUROPA","FERDINAND","GPULTIMATE","TRITON"],"isAddit